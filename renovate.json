{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Stay on MariaDB 12.3 LTS",
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "/^12\\.3(\\.|$)/"
    },
    {
      "description": "Stay on Valkey 9.1",
      "matchPackageNames": ["valkey/valkey"],
      "allowedVersions": "/^9\\.1(\\.|$)/"
    },
    {
      "description": "Stay on HAproxy 3.4",
      "matchPackageNames": ["haproxy"],
      "allowedVersions": "/^3\\.4(\\.|$)/"
    }
  ]
}
